# Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
# Секреты (пустые здесь) заполняются ТОЛЬКО в .env.

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (бот отвечает только ему); узнать: @userinfobot
TELEGRAM_OWNER_ID=

# --- Яндекс Диск ---
# OAuth-токен с правами cloud_api:disk.read и cloud_api:disk.write
YANDEX_DISK_TOKEN=
# Корневая папка на Диске
YANDEX_DISK_ROOT=disk:/Лабы

# --- GigaChat ---
# Ключ авторизации (Authorization key) из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Корневой сертификат Минцифры в PEM (https://www.gosuslugi.ru/crt); без него TLS к GigaChat не пройдёт
GIGACHAT_CA_BUNDLE_FILE=

# --- Общие ---
TZ=Europe/Moscow
# Каталог для SQLite и файлов (в контейнере — volume)
DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
