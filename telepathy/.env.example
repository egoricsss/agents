# Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
# Секреты (пустые здесь) заполняются ТОЛЬКО в .env.

# --- Telegram ---
# Токен бота от @BotFather. В режиме gateway — токен общего бота (тот же, что у шлюза).
TELEGRAM_BOT_TOKEN=
# polling — самостоятельный бот; gateway — апдейты присылает шлюз lab_manager
TELEGRAM_MODE=polling
# Через запятую: кому можно пользоваться ботом. Пусто — всем (пары всё равно приватны).
ALLOWED_USER_IDS=
# Только для gateway: общий секрет со шлюзом (TELEPATHY_SECRET в lab_manager/.env)
GATEWAY_SECRET=
# Где слушать апдейты от шлюза (внутри контейнера; порт наружу не публикуется)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9010

# --- LLM-судья (PydanticAI, «провайдер:модель») ---
LLM_MODEL=deepseek:deepseek-chat
LLM_API_KEY=
# Необязательно: адрес OpenAI-совместимого API (тогда LLM_MODEL=openai-chat:<модель>)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- GigaChat (основной судья при LLM_MODEL=gigachat:GigaChat-2, иначе — запасной) ---
# Ключ авторизации (Authorization key) из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Корневой сертификат Минцифры в PEM; без него TLS к GigaChat не пройдёт (в Docker монтируется)
GIGACHAT_CA_BUNDLE_FILE=

# --- Эмбеддинги (локально, ONNX Runtime без torch) ---
# Репозиторий Hugging Face и файл квантованной модели в нём
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_ONNX_FILE=onnx/model_qint8_avx512_vnni.onnx
EMBEDDING_THREADS=1

# --- Поиск совпадений ---
# Кандидаты — мысли партнёра за последние N часов
MATCH_WINDOW_HOURS=24
# score = cos(a, b) · exp(−Δt / TAU_HOURS)
TAU_HOURS=24
SCORE_THRESHOLD=0.75

# --- Общие ---
TZ=Europe/Moscow
# Каталог для SQLite и кеша модели (в контейнере — volume)
DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
