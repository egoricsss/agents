# Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
# Секреты (пустые здесь) заполняются ТОЛЬКО в .env.

# --- Telegram ---
# Токен бота от @BotFather. В режиме gateway — токен общего бота (тот же, что у шлюза).
TELEGRAM_BOT_TOKEN=
# polling — самостоятельный бот; gateway — апдейты присылает шлюз lab_manager
TELEGRAM_MODE=polling
# Через запятую: кому можно пользоваться ботом. Пусто — всем (пары всё равно приватны).
ALLOWED_USER_IDS=
# Только для gateway: общий секрет со шлюзом (TELEPATHY_SECRET в lab_manager/.env)
GATEWAY_SECRET=
GATEWAY_PORT=9010

# --- LLM-судья (PydanticAI, «провайдер:модель») ---
LLM_MODEL=deepseek:deepseek-chat
LLM_API_KEY=
# Необязательно: адрес OpenAI-совместимого API (тогда LLM_MODEL=openai-chat:<модель>)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- Эмбеддинги (локально, sentence-transformers) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_THREADS=1

# --- Поиск совпадений ---
# Кандидаты — мысли партнёра за последние N часов
MATCH_WINDOW_HOURS=24
# score = cos(a, b) · exp(−Δt / TAU_HOURS)
TAU_HOURS=24
SCORE_THRESHOLD=0.75

# --- Общие ---
TZ=Europe/Moscow
# Каталог для SQLite и кеша модели (в контейнере — volume)
DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
